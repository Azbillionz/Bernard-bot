# ============================================================
# QUANTREXTRADING_BOT — Environment Variables
# Copy to .env and fill in your values.
# Add secrets via Replit Secrets panel, not this file.
# ============================================================

# Telegram
TELEGRAM_BOT_TOKEN=         # From @BotFather
WEBHOOK_DOMAIN=             # e.g. https://your-app.replit.app (leave blank for polling)

# Database (auto-provisioned by Replit)
DATABASE_URL=               # postgres://user:pass@host:5432/db

# Encryption
ENCRYPTION_SECRET=          # 32+ char random string for AES-256-GCM wallet key encryption

# Redis (BullMQ message throttle — 30 msg/sec)
REDIS_URL=                  # redis://localhost:6379 or Upstash URL

# Solana
SOLANA_RPC_URL=             # e.g. https://mainnet.helius-rpc.com/?api-key=xxx
SOLANA_WSS_URL=             # wss://pumpportal.fun/api/data  (PumpFun feed)
JITO_BLOCK_ENGINE_URL=      # https://mainnet.block-engine.jito.wtf
DEFAULT_SOL_JITO_TIP=       # Lamports tip, e.g. 10000

# EVM
ETH_RPC_URL=                # e.g. https://eth.llamarpc.com
FLASHBOTS_RPC_URL=          # https://rpc.flashbots.net
BASE_RPC_URL=               # e.g. https://mainnet.base.org
BSC_RPC_URL=                # e.g. https://bsc-dataseed.binance.org
ONEINCH_API_KEY=            # 1inch Developer API key

# APIs
DEXSCREENER_API_URL=        # https://api.dexscreener.com (default)
GOPLUS_SECURITY_API=        # https://api.gopluslabs.io/api/v1 (default)

# Fee wallet (receives 1% platform fee on every swap)
DEV_FEE_WALLET=             # Solana pubkey or EVM 0x address
